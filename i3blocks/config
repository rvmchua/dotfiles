# i3blocks configuration file
# The interval in which i3blocks refreshes
interval=1

[music]
command=~/.config/i3blocks/mpc_status.sh
interval=1

[cpu]
command=echo "CPU: $(grep 'cpu ' /proc/stat | awk '{print ($2+$4)*100/($2+$4+$5)}' | cut -d'.' -f1)%"
interval=1

[ram]
command=echo "RAM: $(free -h | awk '/^Mem:/ {print $3}' | cut -d'i' -f1)B"
interval=30

# Disk space blocks
[disk_root]
command=echo " Root: $(df -h / | awk 'NR==2 {print $4}')"
interval=60

[disk_home]
command=echo " Home: $(df -h /home | awk 'NR==2 {print $4}')"
interval=60

[disk_other]
command=echo " OtherFiles: $(df -h /home/royce/OtherFiles | awk 'NR==2 {print $4}')"
interval=60

[disk_vault]
command=echo " Vault: $(df -h /mnt/Vault | awk 'NR==2 {print $4}')"
interval=60

[wifi_ssid]
command=~/.config/i3blocks/wifi_ssid.sh
label=
interval=1

[wifi_speed]
command=~/.config/i3blocks/wifi_speed.sh
interval=1

[volume]
command=~/.config/i3blocks/volume_status.sh
interval=1
signal=10

[date]
command=echo "$(date '+%m-%-d-%Y')"
interval=60

[time]
command=echo "$(date '+%I:%M:%S %p')"
interval=1
